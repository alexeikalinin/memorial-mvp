+<script>
+// ═══ WAITLIST MODAL ═══
+(function() {
+  var modal = document.getElementById('waitlist-modal');
+  if (!modal) return;
+  var formView = document.getElementById('waitlist-form-view');
+  var successView = document.getElementById('waitlist-success-view');
+  var form = document.getElementById('waitlist-form');
+  var emailInput = document.getElementById('waitlist-email');
+  var errEl = document.getElementById('waitlist-error');
+  var successMsg = document.getElementById('waitlist-success-msg');
+  var usingDefaultSuccessMsg = true;
+  var selectedPlan = "general";
+  var lastTrigger = null;
+  var duplicateRequest = false;
+  var planLabel = document.createElement("p");
+  planLabel.className = "waitlist-modal-sub";
+  document.getElementById("waitlist-modal-title").after(planLabel);
+
+  function t(key) {
+    var lang = (typeof currentLandingLang !== 'undefined' && currentLandingLang) || 'ru';
+    var dict = (typeof LANDING_I18N !== 'undefined' && LANDING_I18N[lang]) || {};
+    return dict[key] || '';
+  }
+
+  // Called from applyLandingLang() when the user switches language, so the
+  // default (un-overridden) success message stays in sync with the new language.
+  window.__updateWaitlistLang = function() {
+    if (usingDefaultSuccessMsg && successMsg) {
+      successMsg.textContent = t(duplicateRequest ? 'waitlist.duplicate' : 'waitlist.success_default_msg');
+    }
+  };
+
+  function endpoint() {
+    var b = window.__MEMORIAL_API_BASE__;
+    if (typeof b === 'string' && b.length) return b.replace(/\/$/, '') + '/waitlist/';
+    return location.origin + '/api/v1/waitlist/';
+  }
+
+  function openModal(e) {
+    lastTrigger = e.currentTarget;
+    selectedPlan = lastTrigger.getAttribute("data-plan") || "general";
+    duplicateRequest = false;
+    planLabel.textContent = {plus:"Plus · $40",family:"Family · $80",family_pro:"Family Pro · $140",lifetime:"Lifetime"}[selectedPlan] || "";
+    modal.classList.add('is-open');
+    modal.setAttribute('aria-hidden', 'false');
+    errEl.textContent = '';
+    form.reset();
+    usingDefaultSuccessMsg = true;
+    formView.style.display = '';
+    successView.style.display = 'none';
+    setTimeout(function() { emailInput.focus(); }, 200);
+    document.body.style.overflow = 'hidden';
+  }
+
+  function closeModal() {
+    modal.classList.remove('is-open');
+    modal.setAttribute('aria-hidden', 'true');
+    document.body.style.overflow = '';
+    if (lastTrigger) lastTrigger.focus();
+  }
+
+  document.querySelectorAll('.js-waitlist-open').forEach(function(btn) {
+    btn.addEventListener('click', openModal);
+  });
+  document.getElementById('waitlist-close').addEventListener('click', closeModal);
+  document.getElementById('waitlist-cancel').addEventListener('click', closeModal);
+  document.getElementById('waitlist-done').addEventListener('click', closeModal);
+  modal.addEventListener('click', function(e) {
+    if (e.target === modal) closeModal();
+  });
+  document.addEventListener('keydown', function(e) {
+    if (e.key === 'Escape' && modal.classList.contains('is-open')) closeModal();
+  });
+
+  form.addEventListener('submit', function(e) {
+    e.preventDefault();
+    errEl.textContent = '';
+    var email = (emailInput.value || '').trim();
+    if (!emailInput.checkValidity() || !email) {
+      errEl.textContent = t('waitlist.error_invalid_email');
+      return;
+    }
+    var url = endpoint();
+    var submitBtn = document.getElementById('waitlist-submit');
+    submitBtn.disabled = true;
+    fetch(url, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ email: email, source: 'landing_pricing_' + selectedPlan }),
+    })
+      .then(function(res) {
+        return res.json().then(function(j) {
+          if (!res.ok) {
+            var msg = t('waitlist.error_request_failed');
+            if (j.detail) {
+              msg = Array.isArray(j.detail)
+                ? j.detail.map(function(d) { return typeof d === 'object' && d.msg ? d.msg : String(d); }).join(' ')
+                : String(j.detail);
+            }
+            throw new Error(msg);
+          }
+          return j;
+        });
+      })
+      .then(function(data) {
+        formView.style.display = 'none';
+        successView.style.display = 'block';
+        duplicateRequest = !!data.already_registered;
+        usingDefaultSuccessMsg = true;
+        window.__updateWaitlistLang();
+        document.getElementById('waitlist-done').focus();
+      })
+      .catch(function(err) {
+        errEl.textContent = err.message || t('waitlist.error_generic');
+      })
+      .finally(function() {
+        submitBtn.disabled = false;
+      });
+  });
 })();
 </script>
 </body>

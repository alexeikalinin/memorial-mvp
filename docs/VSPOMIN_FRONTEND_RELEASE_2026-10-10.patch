+.pricing-catalog-price { font-size: 24px; }
+.pricing-catalog-price span { font-size: 14px; }
+.pricing-catalog-plan ul { padding-left: 20px; flex: 1; }
+.pricing-catalog-plan li { margin-bottom: 10px; }
+.pricing-catalog-plan .btn { text-align: center; }
+@media (max-width: 1000px) { .pricing-catalog-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
+@media (max-width: 600px) { .pricing-catalog-grid { grid-template-columns: minmax(0, 1fr); } }

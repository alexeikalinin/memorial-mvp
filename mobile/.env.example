# Must be the SAME FastAPI deployment used by the web app. No API secrets here.
# iOS simulator: http://localhost:8000/api/v1
# Android emulator: http://10.0.2.2:8000/api/v1
# Physical phone: http://YOUR_COMPUTER_LAN_IP:8000/api/v1 (same Wi-Fi)
EXPO_PUBLIC_API_URL=https://api.vspomin.ai/api/v1
# Full web SPA base; deployed web uses /app (landing page lives at /).
EXPO_PUBLIC_WEB_URL=https://vspomin.ai/app
